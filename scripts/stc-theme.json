{
  "name": "STC Dark Purple",
  "dataColors": ["#9D8FF0", "#7F77DD", "#5B52B8", "#C4BDF7", "#4A4380", "#E3DFFB"],
  "background": "#211E2B",
  "foreground": "#E6E3F5",
  "tableAccent": "#9D8FF0",
  "textClasses": {
    "title":   { "fontFace": "Segoe UI Semibold", "fontSize": 14, "color": "#E6E3F5" },
    "label":   { "fontFace": "Segoe UI", "fontSize": 10, "color": "#B9B4D0" },
    "callout": { "fontFace": "Segoe UI Semibold", "fontSize": 28, "color": "#FFFFFF" },
    "header":  { "fontFace": "Segoe UI Semibold", "fontSize": 12, "color": "#E6E3F5" }
  },
  "visualStyles": {
    "page": {
      "*": {
        "background": [{ "color": { "solid": { "color": "#15131C" } }, "transparency": 0 }]
      }
    },
    "*": {
      "*": {
        "background": [{ "color": { "solid": { "color": "#211E2B" } }, "transparency": 0 }],
        "border": [{ "show": true, "color": { "solid": { "color": "#38344A" } }, "radius": 12 }]
      }
    }
  }
}